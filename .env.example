DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
ADMIN_EMAILS=marketing.eatrrite@gmail.com

# Mail account the PHP site sends from (includes/secrets.php → mail). Gmail needs an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Eat Rrite
# Comma-separated: every address gets the team booking email.
ADMIN_NOTIFY_EMAIL=

# Protects /api/cron/questionnaire-reminders (send as: Authorization: Bearer <value>).
CRON_SECRET=

# Public address used in email links. Leave empty to use https://www.eatrrite.com.
SITE_URL=
