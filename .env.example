DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
ADMIN_EMAILS=marketing.eatrrite@gmail.com

# Mail account the PHP site sends from (includes/secrets.php → mail). Gmail needs an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Eat Rrite
# Comma-separated: every address gets the team booking and enquiry emails.
ADMIN_NOTIFY_EMAIL=

# WhatsApp Cloud API (docs/whatsApp.md). All optional: without them WhatsApp is skipped.
# Token: a system-user token (never expires). Phone number ID: from WhatsApp → API Setup, not the number.
# Team numbers with country code, comma-separated. Testing: 917993896266. Live: 919639877483.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBERS=

# Protects /api/cron/questionnaire-reminders (send as: Authorization: Bearer <value>).
CRON_SECRET=

# Public address used in email links and sign-in return links. Always set to the real domain
# (Vercel: Production environment). Do not use eatrrite.vercel.app.
SITE_URL=https://www.eatrrite.com

# Search tools (all optional; nothing is added to the page until set).
# Search Console → Add property → URL prefix → HTML tag: the content="…" value only.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML Meta Tag: the msvalidate.01 content value only.
BING_SITE_VERIFICATION=
# Google Analytics → Admin → Data streams → Web: the G-XXXXXXXXXX measurement ID.
# Before setting it, add Google Analytics (visit statistics) to the privacy policy's
# "Who it is shared with" list (constants/legal/privacy.json), with Mukta's approval.
GA_MEASUREMENT_ID=

# Cosmic (site copy). Cosmic → Bucket → Settings → API keys. When not set, the site shows the
# JSON copy in constants/. Vercel needs the slug, the read key and the webhook secret.
COSMIC_BUCKET_SLUG=
COSMIC_READ_KEY=
# Only for `bun run cms:import` on your own computer. Never add it to Vercel.
COSMIC_WRITE_KEY=
# Any long random value (openssl rand -hex 32). Cosmic sends it in the webhook header
# x-webhook-secret so a publish refreshes the site (app/api/cms/revalidate).
COSMIC_WEBHOOK_SECRET=
